# Ignore generated build output and temporary files
**/[Bb]in/
**/[Oo]bj/
**/[Rr]elease/
**/[Dd]ebug/
**/[Aa]rtifacts/

# Ignore Visual Studio and user-specific files
*.user
*.userosscache
*.suo
*.vspx
*.vspscc
*.vssscc
.vs/

# Ignore NuGet and package outputs
*.nupkg
*.snupkg
packages/

# Ignore common logs and diagnostics
*.log
[Ll]ogs/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.binlog

# Ignore local environment and temporary files
.env
~$*
*~

# Ignore legacy .NET lock files
project.lock.json
project.fragment.lock.json

# Ignore tool-specific caches and generated files
CodeCoverage/

# Ignore VS Code workspace settings and launch configs
.vscode/
